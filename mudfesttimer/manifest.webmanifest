{
    "name": "MUDFEST Driver Timer",
    "short_name": "MUDFEST Timer",
    "description": "Offline race timer for MUDFEST marshals.",
    "id": "./",
    "start_url": "./index.html",
    "scope": "./",
    "display": "standalone",
    "display_override": [
        "standalone",
        "minimal-ui"
    ],
    "background_color": "#151515",
    "theme_color": "#151515",
    "orientation": "portrait",
    "categories": [
        "sports",
        "utilities"
    ],
    "icons": [
        {
            "src": "./icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "./icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}